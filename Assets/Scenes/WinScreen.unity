  opponentId: 0
  victoryQuoteText: {fileID: 0}
  textTypeDelay: 0.05
  fullVictoryText: 
  defaultVictoryQuotes: []
  specificQuotes:
  - opponentName: J-Cap(winner) vs Dark J-Cap
    quotes:
    - victoryQuote: "He managed to clone me,\xA7 but he forgot to clone my skills."
      textSize: 17
      victoryPoses:
      - {fileID: 2116409352}
      - {fileID: 648441018}
      - {fileID: 300013548}
      - {fileID: 691026070}
      - {fileID: 1923928185}
    - victoryQuote: "I Win!\xA7 Yay!"
      textSize: 17
      victoryPoses:
      - {fileID: 10350978}
    - victoryQuote: "I'll keep fighting untill i stop Jack from taking over the world\xBD
        and build his own theme park.\xA7 Such a lame motivation!"
      textSize: 17
      victoryPoses:
      - {fileID: 2116409352}
      - {fileID: 648441018}
      - {fileID: 300013548}
    - victoryQuote: "How dare he make a clone out of me!?\xA7 I'll kill him!"
      textSize: 17
      victoryPoses:
      - {fileID: 2116409352}
      - {fileID: 648441018}
      - {fileID: 300013548}
      - {fileID: 691026070}
      - {fileID: 1923928185}
  - opponentName: Dark J-Cap(winner) vs J-Cap
    quotes:
    - victoryQuote: ".\xA7.\xA7."
      textSize: 35
      victoryPoses:
      - {fileID: 936187890}
    - victoryQuote: You suck!
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
      - {fileID: 242135140}
      - {fileID: 1080921530}
      - {fileID: 889601673}
      - {fileID: 1481404749}
      - {fileID: 513616353}
    - victoryQuote: "Hey!\xBD I wrote this song for you.\xA7 Ahem...\xA7 \u266B J-Cap,\xA7
        go suck my sack.\xBD Your personality is really crap.\xA7 While your fighting
        style\xA7 may not be wack,\xA7 your strength really\xBD really lack. \u266B"
      textSize: 17
      victoryPoses:
      - {fileID: 141929018}
  - opponentName: Hoodguy(winner) vs Master J-Cap
    quotes:
    - victoryQuote: "You are not from the future. \xBDYou are just from another universe
        that takes place in the future. \xA7You probably alredy know that though,
        \xA7I don't know why I said that."
      textSize: 0
      victoryPoses:
      - {fileID: 1230458373}
      - {fileID: 1230458373}
      - {fileID: 1230458373}
      - {fileID: 780086078}
  - opponentName: Mike Baller(winner) vs Hoodguy
    quotes:
    - victoryQuote: Spoooky.
      textSize: 17
      victoryPoses:
      - {fileID: 1622268472}
