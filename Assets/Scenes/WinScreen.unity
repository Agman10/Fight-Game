    - {fileID: 1459425579}
  specificQuotes:
  - opponentName: J-Cap
    quotes:
    - victoryQuote: I only get better with age.
      textSize: 17
      victoryPoses:
      - {fileID: 1459425579}
  - opponentName: Dark J-Cap
    quotes:
    - victoryQuote: Wow! I forgot how much more angry you were back in the day.
      textSize: 17
      victoryPoses:
      - {fileID: 1459425579}
  - opponentName: J-3116
    quotes:
    - victoryQuote: I don't remember seeing a robot version of myself in my universe.
      textSize: 17
      victoryPoses:
      - {fileID: 1459425579}
  - opponentName: Mike Baller
    quotes:
    - victoryQuote: Hello Young Mike Baller!
      textSize: 17
      victoryPoses:
      - {fileID: 1459425579}
  - opponentName: Violent Mike
    quotes:
    - victoryQuote: Your tactics make me VIOLENT haha!
      textSize: 17
      victoryPoses:
      - {fileID: 1459425579}
  - opponentName: HoodGuy
    quotes:
    - victoryQuote: I still don't know who you are.
      textSize: 17
      victoryPoses:
      - {fileID: 1459425579}
  - opponentName: Master J-Cap
    quotes:
    - victoryQuote: Hello me!
      textSize: 17
      victoryPoses:
      - {fileID: 1459425579}
  - opponentName: Old Mike
    quotes:
    - victoryQuote: Always fun to fight you. How are you here anyways?
      textSize: 17
      victoryPoses:
      - {fileID: 1459425579}
  - opponentName: Demon
    quotes:
    - victoryQuote: I've sent you "home" before and I definitely have no problem
        doing it again...
      textSize: 17
      victoryPoses:
      - {fileID: 1459425579}
  - opponentName: Witch
    quotes:
    - victoryQuote: Placeholder...
      textSize: 17
      victoryPoses:
      - {fileID: 1459425579}
  - opponentName: Joe
    quotes: []
  - opponentName: J-Cap (Jane)
    quotes:
    - victoryQuote: "You look like me \xBDif I was younger\xBD, and a woman."
      textSize: 17
      victoryPoses:
      - {fileID: 1459425579}
