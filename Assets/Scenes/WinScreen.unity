      textSize: 17
      victoryPoses:
      - {fileID: 1512268779}
  - opponentName: HoodGuy
    quotes:
    - victoryQuote: You really are an unknown entity.
      textSize: 17
      victoryPoses:
      - {fileID: 736521287}
  - opponentName: Master J-Cap
    quotes:
    - victoryQuote: GG!
      textSize: 17
      victoryPoses:
      - {fileID: 1512268779}
  - opponentName: Old Mike
    quotes:
    - victoryQuote: Get out of here you impersonator!
      textSize: 17
      victoryPoses:
      - {fileID: 791851821}
  - opponentName: Demon
    quotes:
    - victoryQuote: Another demon...
      textSize: 17
      victoryPoses:
      - {fileID: 736521287}
  - opponentName: Witch
