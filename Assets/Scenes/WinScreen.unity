  - opponentName: Witch
    quotes:
    - victoryQuote: (I can fix her!)
      textSize: 17
      victoryPoses:
      - {fileID: 1887321831}
  - opponentName: Joe
    quotes:
    - victoryQuote: "I understand that you're a big fan,\xBD but please don't impersonate
