  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2b39d420f0e11fe44a010b5d73d31e44, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  opponentId: 0
  victoryQuoteText: {fileID: 347125222}
  textTypeDelay: 0.05
  fullVictoryText: 
  defaultVictoryQuotes:
  - victoryQuote: Mission Complete!
    textSize: 17
    victoryPoses:
    - {fileID: 1707360358}
  specificQuotes:
  - opponentName: J-Cap
    quotes:
    - victoryQuote: "Training complete!\xA7 Initiating emergency treatment mode."
      textSize: 17
      victoryPoses:
      - {fileID: 1707360358}
    - victoryQuote: I  was built to be exactly like you so this outcome was 50%.
      textSize: 17
      victoryPoses:
      - {fileID: 1707360358}
  - opponentName: Dark J-Cap
    quotes:
    - victoryQuote: Fake J-Cap detected!
      textSize: 17
      victoryPoses:
      - {fileID: 239573828}
      - {fileID: 608113982}
    - victoryQuote: Beep boop motherfucker!
      textSize: 17
      victoryPoses:
      - {fileID: 239573828}
    - victoryQuote: "You are edgy.\xBD Just like spikes.\xBD I hate spikes!"
      textSize: 17
      victoryPoses:
      - {fileID: 239573828}
  - opponentName: J-3116
    quotes:
    - victoryQuote: "What?\xA7 Have they started to mass-produce me?"
      textSize: 17
      victoryPoses:
      - {fileID: 1707360358}
      - {fileID: 207091492}
    - victoryQuote: "Your code will make a fine dinner!\xA7 ...\xA7Get it?\xA7 Because
        your code is spaghetti."
      textSize: 17
      victoryPoses:
      - {fileID: 1707360358}
      - {fileID: 595078708}
    - victoryQuote: Very bad. You must be a prototype.
      textSize: 17
      victoryPoses:
      - {fileID: 1707360358}
      - {fileID: 1103540019}
    - victoryQuote: "Looks like you encountered a\xA7 fatal error."
      textSize: 17
      victoryPoses:
      - {fileID: 1707360358}
      - {fileID: 1103540019}
  - opponentName: Mike Baller
    quotes:
    - victoryQuote: Hello Mike Baller! Where is M25-B48?
      textSize: 17
      victoryPoses:
      - {fileID: 1707360358}
  - opponentName: Violent Mike
    quotes:
    - victoryQuote: You are not the real Mike!
      textSize: 17
      victoryPoses:
      - {fileID: 1707360358}
      - {fileID: 608113982}
  - opponentName: HoodGuy
    quotes:
    - victoryQuote: You are the type of guy to download more ram and then it actually
        works.
      textSize: 17
      victoryPoses:
      - {fileID: 1707360358}
  - opponentName: Master J-Cap
    quotes:
    - victoryQuote: J-Cap?
      textSize: 17
      victoryPoses:
      - {fileID: 1707360358}
  - opponentName: Old Mike
    quotes:
    - victoryQuote: Mike?
      textSize: 17
      victoryPoses:
      - {fileID: 1707360358}
  - opponentName: Demon
    quotes:
    - victoryQuote: Demonic entity exterminated!
      textSize: 17
      victoryPoses:
      - {fileID: 608113982}
  - opponentName: Witch
    quotes:
    - victoryQuote: 'As a great robot once said: Hasta la vista, baby.'
      textSize: 17
      victoryPoses:
      - {fileID: 1707360358}
  - opponentName: Joe
    quotes: []
  - opponentName: J-Cap (Jane)
    quotes:
    - victoryQuote: What happened to you J-Cap?
      textSize: 17
      victoryPoses:
      - {fileID: 207091492}
