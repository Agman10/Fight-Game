  textTypeDelay: 0.05
  fullVictoryText: 
  defaultVictoryQuotes:
  - victoryQuote: I won!
    textSize: 17
    victoryPoses:
    - {fileID: 1541653663}
  specificQuotes:
  - opponentName: J-Cap
    quotes:
    - victoryQuote: Why take a stairway to heaven when you can just ride the highway
        to hell?
      textSize: 17
      victoryPoses:
      - {fileID: 344431371}
    - victoryQuote: JACK is gonna be furious when he finds out that I killed J-Cap
        and not him...
      textSize: 17
      victoryPoses:
      - {fileID: 344431371}
  - opponentName: Dark J-Cap
    quotes:
    - victoryQuote: You are so full of hate, Such a shame I have to kill you...
      textSize: 17
      victoryPoses:
      - {fileID: 258561492}
    - victoryQuote: You were meant for evil, Dark...
      textSize: 17
      victoryPoses:
      - {fileID: 258561492}
  - opponentName: J-3116
    quotes:
    - victoryQuote: AI slop...
      textSize: 17
      victoryPoses:
      - {fileID: 258561492}
  - opponentName: Mike Baller
    quotes:
    - victoryQuote: Have fun in this pathetic place called "Heaven"!
      textSize: 17
      victoryPoses:
      - {fileID: 578906523}
  - opponentName: Violent Mike
    quotes:
    - victoryQuote: Placeholder...
      textSize: 17
      victoryPoses:
      - {fileID: 1541653663}
  - opponentName: HoodGuy
    quotes:
    - victoryQuote: You died like you lived, unforgotten...
      textSize: 17
      victoryPoses:
      - {fileID: 258561492}
  - opponentName: Master J-Cap
    quotes:
    - victoryQuote: Death is calling, John.
      textSize: 17
      victoryPoses:
      - {fileID: 578906523}
  - opponentName: Old Mike
    quotes:
    - victoryQuote: Placeholder...
      textSize: 17
      victoryPoses:
      - {fileID: 1541653663}
  - opponentName: Demon
    quotes:
    - victoryQuote: Huh, another me?
      textSize: 17
      victoryPoses:
      - {fileID: 258561492}
    - victoryQuote: Not even I can satisfy my blood lust!
      textSize: 17
      victoryPoses:
      - {fileID: 258561492}
  - opponentName: Witch
    quotes:
    - victoryQuote: Placeholder...
      textSize: 17
      victoryPoses:
      - {fileID: 344431371}
  - opponentName: Joe
    quotes:
    - victoryQuote: Just fighting you is humiliating...
