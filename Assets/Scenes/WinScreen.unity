  specificQuotes:
  - opponentName: J-Cap
    quotes:
    - victoryQuote: "I did it! \xBDEveryone will know how awesome I am now!"
      textSize: 17
      victoryPoses:
      - {fileID: 1168442154}
  - opponentName: Dark J-Cap
    quotes:
    - victoryQuote: This is what you get when you underestimate a pro!
      textSize: 17
      victoryPoses:
      - {fileID: 1607822275}
  - opponentName: J-3116
    quotes:
    - victoryQuote: AI can't replicate true mastery!
      textSize: 17
      victoryPoses:
      - {fileID: 1887321831}
  - opponentName: Mike Baller
    quotes:
    - victoryQuote: "Autographs are free.\xBD You don't have to fight for it."
      textSize: 17
      victoryPoses:
      - {fileID: 1832664477}
  - opponentName: Violent Mike
    quotes:
    - victoryQuote: Now you know what it feels like to be a total loser!
      textSize: 17
      victoryPoses:
      - {fileID: 1607822275}
  - opponentName: HoodGuy
    quotes:
    - victoryQuote: "For a loser,\xBD you did pretty well."
      textSize: 17
      victoryPoses:
      - {fileID: 350832685}
  - opponentName: Master J-Cap
    quotes: []
  - opponentName: Old Mike
    quotes: []
  - opponentName: Demon
    quotes:
    - victoryQuote: Placeholder...
      textSize: 17
      victoryPoses:
