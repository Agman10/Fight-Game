  victoryQuoteText: {fileID: 347125222}
  textTypeDelay: 0.05
  fullVictoryText: 
  defaultVictoryQuotes:
  - victoryQuote: "Burn baby! \xA7\xA7Burn!"
    textSize: 17
    victoryPoses:
