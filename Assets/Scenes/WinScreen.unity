--- !u!114 &1266130181
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1266130180}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2b39d420f0e11fe44a010b5d73d31e44, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  opponentId: 0
  victoryQuoteText: {fileID: 347125222}
  textTypeDelay: 0.05
  fullVictoryText: 
  defaultVictoryQuotes:
  - victoryQuote: You seem to be in a SHOCK!
    textSize: 17
    victoryPoses:
    - {fileID: 1622268472}
  specificQuotes:
  - opponentName: J-Cap
    quotes:
    - victoryQuote: I win this time. My friend.
      textSize: 17
      victoryPoses:
      - {fileID: 544593155}
    - victoryQuote: Don't worry Il'l use my electric hands to revive you.
      textSize: 17
      victoryPoses:
      - {fileID: 901267760}
    - victoryQuote: "Oh you mean this thing?\xBD An alien gave it to me as a gift.\xBD
        My electricity gives it infinite ammo."
      textSize: 17
      victoryPoses:
      - {fileID: 273729045}
  - opponentName: Dark J-Cap
    quotes:
    - victoryQuote: Im not fat! Im just spherical.
      textSize: 17
      victoryPoses:
      - {fileID: 1323845304}
    - victoryQuote: Stop harrasing J-Cap all the time! Just because you're his clone
        does't mean you have the right to do it.
      textSize: 17
      victoryPoses:
      - {fileID: 1323845304}
    - victoryQuote: You are so sad!
      textSize: 17
      victoryPoses:
      - {fileID: 1323845304}
      - {fileID: 901267760}
      - {fileID: 1622268472}
    - victoryQuote: Wow! You really are just as edgy as J-Cap said.
      textSize: 17
      victoryPoses:
      - {fileID: 1323845304}
      - {fileID: 901267760}
      - {fileID: 1622268472}
    - victoryQuote: What do you mean im fighting like some green dude?
      textSize: 17
      victoryPoses:
      - {fileID: 1323845304}
      - {fileID: 901267760}
      - {fileID: 1622268472}
    - victoryQuote: Did you find my skills SHOCKING?
      textSize: 17
      victoryPoses:
      - {fileID: 544593155}
      - {fileID: 901267760}
  - opponentName: J-3116
    quotes:
    - victoryQuote: What!? There is a robot version of J-Cap!? I'm jealous.
      textSize: 17
      victoryPoses:
      - {fileID: 901267760}
      - {fileID: 1622268472}
  - opponentName: Mike Baller
    quotes:
    - victoryQuote: I can roll better than you.
      textSize: 17
      victoryPoses:
      - {fileID: 544593155}
      - {fileID: 1323845304}
      - {fileID: 901267760}
      - {fileID: 1622268472}
    - victoryQuote: Wow! Im fighting myself in a different color. This is just like
        a fighting game!
      textSize: 17
      victoryPoses:
      - {fileID: 544593155}
      - {fileID: 901267760}
      - {fileID: 1622268472}
  - opponentName: Violent Mike
    quotes:
    - victoryQuote: All the jokes I made at J-Caps expense about dark clones really
        has come back to bite me huh?
      textSize: 17
      victoryPoses:
      - {fileID: 1323845304}
      - {fileID: 901267760}
      - {fileID: 1622268472}
    - victoryQuote: You might know everything about me but it doesn't matter since
        i know everything about YOU! Strange isn't it?
      textSize: 17
      victoryPoses:
      - {fileID: 1323845304}
      - {fileID: 901267760}
    - victoryQuote: This is plagiarism and It won't be tolerated!
      textSize: 17
      victoryPoses:
      - {fileID: 1892137579}
    - victoryQuote: You're not even good enough to be my fake.
      textSize: 17
      victoryPoses:
      - {fileID: 901267760}
  - opponentName: HoodGuy
    quotes:
    - victoryQuote: Now you're just an Unknown Loser.
      textSize: 17
      victoryPoses:
      - {fileID: 1622268472}
    - victoryQuote: "Todays weather: \xA7thunder bolt and lightning \xBDand it's
        very very frightening!"
      textSize: 17
      victoryPoses:
      - {fileID: 1323845304}
  - opponentName: Master J-Cap
    quotes:
    - victoryQuote: Hi J-Cap. You look old. Are you tired?
      textSize: 17
      victoryPoses:
      - {fileID: 901267760}
  - opponentName: Old Mike
    quotes:
    - victoryQuote: Wow! I still look good when im old.
      textSize: 17
      victoryPoses:
      - {fileID: 544593155}
  - opponentName: Demon
    quotes:
    - victoryQuote: "Die monster.\xA7 You don't belong in this world!"
      textSize: 17
      victoryPoses:
      - {fileID: 1323845304}
    - victoryQuote: "Huh?\xA7 You can't handle my anvil?\xA7 I thought you loved
        heavy metal!"
      textSize: 17
      victoryPoses:
      - {fileID: 1622268472}
  - opponentName: Witch
    quotes:
    - victoryQuote: Ding Dong! The evil witch is dead!
      textSize: 17
      victoryPoses:
      - {fileID: 544593155}
  - opponentName: Joe
    quotes:
    - victoryQuote: "Atleast you have um...\xA7 Confidence!"
      textSize: 17
      victoryPoses:
      - {fileID: 1622268472}
