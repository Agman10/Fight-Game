--- !u!114 &2063401134
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2063401132}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2b39d420f0e11fe44a010b5d73d31e44, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  opponentId: 0
  victoryQuoteText: {fileID: 347125222}
  textTypeDelay: 0.05
  fullVictoryText: 
  defaultVictoryQuotes:
  - victoryQuote: "Winning and taking it all is not enough. \xBDThe loser also has
      to fall."
    textSize: 17
    victoryPoses:
    - {fileID: 2007861540}
  specificQuotes:
  - opponentName: J-Cap
    quotes:
    - victoryQuote: Hahahahahaha!
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
      - {fileID: 1080921530}
      - {fileID: 1663540919}
    - victoryQuote: "What's the matter?\xA7 ...Can't defeat your own clone?"
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
      - {fileID: 242135140}
      - {fileID: 1080921530}
      - {fileID: 1481404749}
      - {fileID: 513616353}
    - victoryQuote: Im the superior John.
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
      - {fileID: 242135140}
      - {fileID: 1080921530}
      - {fileID: 889601673}
      - {fileID: 1481404749}
      - {fileID: 513616353}
    - victoryQuote: Stop calling me edgy!
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
      - {fileID: 242135140}
      - {fileID: 1080921530}
      - {fileID: 889601673}
      - {fileID: 1481404749}
      - {fileID: 513616353}
    - victoryQuote: "Why is our last name \"Capsule\" anyway?\xA7 That like if a
        dog had \"Dog\" as it's last name...\xA7 So stupid!"
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
      - {fileID: 242135140}
      - {fileID: 1080921530}
      - {fileID: 1481404749}
    - victoryQuote: You are already dead.
      textSize: 17
      victoryPoses:
      - {fileID: 958009826}
    - victoryQuote: "Stupid people can believe in anything.\xBD So you can believe
        in yourself."
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
      - {fileID: 242135140}
      - {fileID: 1080921530}
      - {fileID: 1481404749}
      - {fileID: 513616353}
    - victoryQuote: "Oh look,\xBD you gained a new ability.\xA7 Flying!"
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
      - {fileID: 242135140}
      - {fileID: 1080921530}
    - victoryQuote: I will be the one to kill Jack. Not You.
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
      - {fileID: 1080921530}
      - {fileID: 1663540919}
      - {fileID: 513616353}
    - victoryQuote: You can be crueler than that, John.
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
      - {fileID: 1080921530}
      - {fileID: 513616353}
  - opponentName: Dark J-Cap
    quotes:
    - victoryQuote: "A clone of a clone?\xA7 Weird!"
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
      - {fileID: 964972798}
    - victoryQuote: Finally, a challenge!
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
      - {fileID: 513616353}
  - opponentName: J-3116
    quotes:
    - victoryQuote: They should have made a Dark J-3116 instead...
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
  - opponentName: Mike Baller
    quotes:
    - victoryQuote: You lost you fat fuck! Next time eat a salad!
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
      - {fileID: 513616353}
      - {fileID: 1080921530}
    - victoryQuote: I knew J-Cap's friends would be stupid and annoying!
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
      - {fileID: 513616353}
      - {fileID: 1080921530}
      - {fileID: 242135140}
    - victoryQuote: J-Cap's friends are all sooo pathetic! Maybe if there was a "Dark"
        version of them, then i could maybe tolerate them.
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
      - {fileID: 513616353}
      - {fileID: 1080921530}
      - {fileID: 242135140}
    - victoryQuote: "Defeating you takes less effort than smacking a baby.\xA7 Not
        that I'd ever do that..."
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
      - {fileID: 513616353}
      - {fileID: 1080921530}
      - {fileID: 242135140}
  - opponentName: Violent Mike
    quotes:
    - victoryQuote: Hi! Are you busy this weekend?
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
      - {fileID: 513616353}
      - {fileID: 1080921530}
    - victoryQuote: You must defeat my Razor Kick to stand a chance.
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
      - {fileID: 513616353}
      - {fileID: 1080921530}
  - opponentName: HoodGuy
    quotes:
    - victoryQuote: Who the hell are you!?
      textSize: 17
      victoryPoses:
      - {fileID: 199954725}
    - victoryQuote: "You give me the creeps, \xBDyou interdimensional freak!"
      textSize: 17
      victoryPoses:
      - {fileID: 513616353}
  - opponentName: Master J-Cap
    quotes:
    - victoryQuote: Wow J-Cap You look so old! Go back to your retirement home hahaha!
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
  - opponentName: Old Mike
    quotes:
    - victoryQuote: Haha! You're old!
      textSize: 17
      victoryPoses:
      - {fileID: 1438088517}
  - opponentName: Demon
    quotes:
    - victoryQuote: "I have little tolerance for demons...\xA7 much less inferior
        ones like you."
      textSize: 17
      victoryPoses:
      - {fileID: 513616353}
    - victoryQuote: "Dead \xBDbut not forgiven."
      textSize: 17
      victoryPoses:
      - {fileID: 513616353}
    - victoryQuote: "I can kill demons like you. \xA7But i cant kill the demons inside
        of me..."
      textSize: 17
      victoryPoses:
      - {fileID: 513616353}
  - opponentName: Witch
    quotes:
    - victoryQuote: Burn you witch! Go to hell where you belong!
      textSize: 17
      victoryPoses:
      - {fileID: 513616353}
      - {fileID: 1438088517}
      - {fileID: 1080921530}
  - opponentName: Joe
    quotes:
    - victoryQuote: Is this some kind of joke?
      textSize: 17
      victoryPoses:
      - {fileID: 199954725}
    - victoryQuote: An evil version of you would be a Dark Joek...
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
      - {fileID: 1438088517}
  - opponentName: J-Cap (Jane)
    quotes:
    - victoryQuote: You're just as unlikable as a woman.
      textSize: 17
      victoryPoses:
      - {fileID: 2007861540}
      - {fileID: 513616353}
