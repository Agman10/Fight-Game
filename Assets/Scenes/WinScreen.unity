--- !u!114 &1770513577
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1770513576}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2b39d420f0e11fe44a010b5d73d31e44, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  opponentId: 0
  victoryQuoteText: {fileID: 347125222}
  textTypeDelay: 0.05
  fullVictoryText: 
  defaultVictoryQuotes:
  - victoryQuote: That was heated!
    textSize: 17
    victoryPoses:
    - {fileID: 300013548}
  specificQuotes:
  - opponentName: J-Cap
    quotes:
    - victoryQuote: What im fighting myself!?
      textSize: 17
      victoryPoses:
      - {fileID: 300013548}
      - {fileID: 176385814}
    - victoryQuote: "You are HOT!\xA7 Litterary!"
      textSize: 17
      victoryPoses:
      - {fileID: 300013548}
    - victoryQuote: Impostor!!!
      textSize: 17
      victoryPoses:
      - {fileID: 994582938}
  - opponentName: Dark J-Cap
    quotes:
    - victoryQuote: You are so Rude...
      textSize: 17
      victoryPoses:
      - {fileID: 2116409352}
      - {fileID: 648441018}
      - {fileID: 300013548}
    - victoryQuote: "They managed to clone me,\xA7 but they forgot to clone my skills."
      textSize: 17
      victoryPoses:
      - {fileID: 2116409352}
      - {fileID: 648441018}
      - {fileID: 300013548}
      - {fileID: 691026070}
      - {fileID: 1923928185}
    - victoryQuote: Edgelord...
      textSize: 17
      victoryPoses:
      - {fileID: 2116409352}
      - {fileID: 648441018}
      - {fileID: 300013548}
      - {fileID: 691026070}
      - {fileID: 1923928185}
    - victoryQuote: Burn to the ground!
      textSize: 17
      victoryPoses:
      - {fileID: 300013548}
      - {fileID: 71384199}
    - victoryQuote: Atleast you're handsome.
      textSize: 17
      victoryPoses:
      - {fileID: 2116409352}
      - {fileID: 648441018}
      - {fileID: 300013548}
      - {fileID: 691026070}
      - {fileID: 1923928185}
    - victoryQuote: Asshole!
      textSize: 17
      victoryPoses:
      - {fileID: 2116409352}
      - {fileID: 648441018}
      - {fileID: 300013548}
      - {fileID: 1923928185}
      - {fileID: 71384199}
    - victoryQuote: "You only hate evil. \xBDYou don't love goodness."
      textSize: 17
      victoryPoses:
      - {fileID: 176385814}
  - opponentName: J-3116
    quotes:
    - victoryQuote: "What!?\xA7 Why is there a robot version of me?\xA7 Whats next?\xA7
        A gender swapped version of me?"
      textSize: 17
      victoryPoses:
      - {fileID: 300013548}
      - {fileID: 176385814}
    - victoryQuote: This is getting out of hand! Why are there so many versions of
        me!?
      textSize: 17
      victoryPoses:
      - {fileID: 300013548}
      - {fileID: 176385814}
    - victoryQuote: Cool. I always wanted to know how i would look like if i were
        a robot.
      textSize: 17
      victoryPoses:
      - {fileID: 300013548}
  - opponentName: Mike Baller
    quotes:
    - victoryQuote: Hello Mike! good to see you.
      textSize: 17
      victoryPoses:
      - {fileID: 300013548}
    - victoryQuote: Come on Mike! You are better than this.
      textSize: 17
      victoryPoses:
      - {fileID: 300013548}
      - {fileID: 2116409352}
      - {fileID: 1923928185}
  - opponentName: Violent Mike
    quotes:
    - victoryQuote: Why are you called "Violent Mike"? Is Mike not already kinda
        violent?
      textSize: 17
      victoryPoses:
      - {fileID: 300013548}
    - victoryQuote: Oh seems like Mike also got a mean clone...
      textSize: 17
      victoryPoses:
      - {fileID: 300013548}
    - victoryQuote: "No!\xBD That is NOT Mike Baller!"
      textSize: 17
      victoryPoses:
      - {fileID: 71384199}
  - opponentName: HoodGuy
    quotes:
    - victoryQuote: You are so creepy...
      textSize: 17
      victoryPoses:
      - {fileID: 300013548}
  - opponentName: Master J-Cap
    quotes:
    - victoryQuote: So this is me when im old?
      textSize: 17
      victoryPoses:
      - {fileID: 300013548}
  - opponentName: Old Mike
    quotes:
    - victoryQuote: Wow Mike! You look older!
      textSize: 17
      victoryPoses:
      - {fileID: 300013548}
  - opponentName: Demon
    quotes:
    - victoryQuote: Go back to hell!
      textSize: 17
      victoryPoses:
      - {fileID: 71384199}
  - opponentName: Witch
    quotes:
    - victoryQuote: Now this is a witch burning!
      textSize: 17
      victoryPoses:
      - {fileID: 300013548}
  - opponentName: Joe
    quotes:
    - victoryQuote: Believe in yourself and keep training. Then you might be able
        to do a little damage on me atleast.
      textSize: 17
      victoryPoses:
      - {fileID: 300013548}
  - opponentName: J-Cap (Jane)
    quotes:
    - victoryQuote: You are the prettiest woman I've seen.
      textSize: 17
      victoryPoses:
      - {fileID: 300013548}
