      victoryPoses:
      - {fileID: 838718978}
  - opponentName: J-3116
    quotes:
    - victoryQuote: Where is the robot version of me?
      textSize: 17
      victoryPoses:
      - {fileID: 1464362060}
  - opponentName: Mike Baller
    quotes:
    - victoryQuote: How weak I use to be... Compared to now.
      textSize: 17
      victoryPoses:
      - {fileID: 736521287}
  - opponentName: Violent Mike
    quotes:
    - victoryQuote: "My grandson became a teenager recently.\xBD He kinda acts like
