  specificQuotes:
  - opponentName: J-Cap
    quotes:
    - victoryQuote: "I gotta say,\xBD you're a pretty handsome guy."
      textSize: 17
      victoryPoses:
      - {fileID: 1650282356}
  - opponentName: Dark J-Cap
    quotes:
    - victoryQuote: "Good grief.\xBD A male Dark J-Cap..."
      textSize: 17
      victoryPoses:
      - {fileID: 1650282356}
    - victoryQuote: You're just as unlikable as a man.
      textSize: 17
      victoryPoses:
      - {fileID: 1650282356}
  - opponentName: J-3116
    quotes: []
  - opponentName: Mike Baller
    quotes:
    - victoryQuote: "What? \xA7Michelle?"
      textSize: 17
      victoryPoses:
      - {fileID: 1650282356}
  - opponentName: Violent Mike
    quotes: []
  - opponentName: HoodGuy
    quotes: []
  - opponentName: Master J-Cap
    quotes:
    - victoryQuote: "What!? \xA7What is this!?"
      textSize: 17
      victoryPoses:
      - {fileID: 1650282356}
  - opponentName: Old Mike
    quotes: []
  - opponentName: Demon
    quotes:
    - victoryQuote: "That male disguise won't work Nicolle! \xA7You can't run away
        from me!"
      textSize: 17
      victoryPoses:
      - {fileID: 1650282356}
  - opponentName: Witch
    quotes: []
  - opponentName: Joe
    quotes:
    - victoryQuote: Changing gender won't help you improve, Joan! I mean Joe!
      textSize: 17
      victoryPoses:
      - {fileID: 1650282356}
  - opponentName: J-Cap (Jane)
