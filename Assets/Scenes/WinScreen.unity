  m_Script: {fileID: 11500000, guid: 2b39d420f0e11fe44a010b5d73d31e44, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  opponentId: 0
  victoryQuoteText: {fileID: 347125222}
  textTypeDelay: 0.05
  fullVictoryText: 
  defaultVictoryQuotes:
  - victoryQuote: How many more worthless fights do I have to finish?
    textSize: 17
    victoryPoses:
    - {fileID: 1940320020}
  specificQuotes:
  - opponentName: J-Cap
    quotes:
    - victoryQuote: "Pain...\xA7 This is why I fight."
      textSize: 17
      victoryPoses:
      - {fileID: 1568315068}
      - {fileID: 1381715594}
    - victoryQuote: You got so fucked, this match could be uploaded to an adult site.
      textSize: 17
      victoryPoses:
      - {fileID: 1568315068}
      - {fileID: 1940320020}
    - victoryQuote: "J-Cap?\xA7 More like \xBDJ-Crap!"
      textSize: 17
      victoryPoses:
      - {fileID: 69779437}
  - opponentName: Dark J-Cap
    quotes:
    - victoryQuote: Do you have any idea about who's responsible for my existance?
      textSize: 17
      victoryPoses:
      - {fileID: 1381715594}
      - {fileID: 1568315068}
      - {fileID: 1940320020}
    - victoryQuote: You are wrong. Mike Baller is way more stupid and annoying than
        J-Cap.
      textSize: 17
      victoryPoses:
      - {fileID: 1381715594}
      - {fileID: 1568315068}
      - {fileID: 1940320020}
    - victoryQuote: I stole this gun from an alien.
      textSize: 17
      victoryPoses:
      - {fileID: 1793777488}
  - opponentName: J-3116
    quotes:
    - victoryQuote: You got short circuited! Hahahaha!
      textSize: 17
      victoryPoses:
      - {fileID: 1568315068}
  - opponentName: Mike Baller
    quotes:
    - victoryQuote: I'm more baller than you!
      textSize: 17
      victoryPoses:
      - {fileID: 1381715594}
      - {fileID: 1568315068}
      - {fileID: 1940320020}
    - victoryQuote: 92.28.211.234
      textSize: 17
      victoryPoses:
      - {fileID: 1568315068}
    - victoryQuote: Blue electricity is way prettier than yellow electricty. It looks
        like piss!
      textSize: 17
      victoryPoses:
      - {fileID: 1568315068}
  - opponentName: Violent Mike
    quotes:
    - victoryQuote: Seems like I also have a clone which is weird since I'm alredy
        a clone.
      textSize: 17
      victoryPoses:
      - {fileID: 1381715594}
      - {fileID: 1568315068}
  - opponentName: HoodGuy
    quotes:
    - victoryQuote: "You are so bad!\xA7 You are also weird!"
      textSize: 17
      victoryPoses:
      - {fileID: 1568315068}
      - {fileID: 1940320020}
  - opponentName: Master J-Cap
    quotes:
    - victoryQuote: You're the master of sucking!
      textSize: 17
      victoryPoses:
      - {fileID: 1568315068}
  - opponentName: Old Mike
    quotes:
    - victoryQuote: Retired!
      textSize: 17
      victoryPoses:
      - {fileID: 1568315068}
  - opponentName: Demon
    quotes:
    - victoryQuote: Placeholder...
      textSize: 17
      victoryPoses:
      - {fileID: 1568315068}
  - opponentName: Witch
    quotes:
    - victoryQuote: Placeholder...
      textSize: 17
